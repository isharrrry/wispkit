						"*.css",
						"*.scss",
						"*.less",
						"*.styl",
						"*.diff",
						"*.patch"
					],
					"description": "%config.readonly.extensions.description%"
				},
				"wispkit.subtree.columns": {
					"type": "array",
					"default": [
						"name",
						"size",
						"type",
						"mtime",
						"ctime",
						"owner"
					],
					"items": {
						"type": "string",
						"enum": [
							"name",
							"ext",
							"size",
							"mtime",
							"ctime",
							"atime",
							"owner",
							"mode",
							"type"
						]
					},
					"description": "%config.subtree.columns.description%"
				},
				"wispkit.subtree.tools": {
					"type": "array",
					"default": [],
					"items": {
						"type": "object",
						"required": [
							"label",
							"command"
						],
						"properties": {
							"label": {
								"type": "string"
							},
							"command": {
								"type": "string"
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"shell": {
								"type": "string",
								"enum": [
									"silent",
									"currentTerminal",
									"newTerminal",
									"external"
								]
							}
						}
					},
					"description": "%config.subtree.tools.description%"
				},
				"wispkit.resourceTree.file": {
					"type": "string",
					"default": ".WispkitView/resource-tree.json",
					"description": "%config.resourceTree.file.description%"
				}
			}
		},
		"configurationDefaults": {
			"markdown-mermaid.mouseNavigation.enabled": "always"
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./ && node esbuild.mjs",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src",
		"test": "npm run compile && mocha \"out/test/**/*.test.js\"",
		"package": "vsce package --baseContentUrl https://github.com/isharrrry/wispkit/blob/master --baseImagesUrl https://github.com/isharrrry/wispkit/raw/master"
	},
