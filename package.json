						"*.ts",
						"*.tsx",
						"*.mts",
						"*.cts",
						"*.js",
						"*.jsx",
						"*.mjs",
						"*.cjs",
						"*.vue",
						"*.svelte",
						"*.py",
						"*.cs",
						"*.fs",
						"*.vb",
						"*.java",
						"*.kt",
						"*.go",
						"*.rs",
						"*.rb",
						"*.php",
						"*.swift",
						"*.lua",
