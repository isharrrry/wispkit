{
	"name": "wispkit",
	"displayName": "Wispkit",
	"description": "Browsing enhancements for Markdown, images, videos, HTML and XAML: preview-script injection with nonce/CSP, table of contents, default wheel zoom, right-drag pan, media context menu (save as / copy path / copy source), drawio block editing, and in-editor link navigation (relative paths, vscode://file, line numbers).",
	"version": "0.2.15",
	"publisher": "harrrry",
	"author": "None",
	"license": "MIT",
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/isharrrry/wispkit.git"
	},
	"homepage": "https://github.com/isharrrry/wispkit#readme",
	"bugs": {
		"url": "https://github.com/isharrrry/wispkit/issues"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0",
		"vscode": "^1.71.0"
	},
	"categories": [
		"Other",
		"Visualization"
	],
	"keywords": [
		"markdown",
		"preview",
		"image",
		"video",
		"zoom",
		"mermaid",
		"drawio",
		"xaml",
		"toc"
	],
	"extensionKind": [
		"workspace"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onCustomEditor:wispkit.markdown",
		"onCustomEditor:wispkit.mermaid",
		"onCustomEditor:wispkit.image",
		"onCustomEditor:wispkit.video",
		"onCustomEditor:wispkit.html",
		"onCustomEditor:wispkit.xaml",
		"onCommand:wispkit.openWith",
		"onCommand:wispkit.toggleReadOnly",
		"onCommand:wispkit.subtree.open",
		"onCommand:wispkit.wispkitView.open",
		"onCommand:wispkit.graph3d.open",
		"onCommand:wispkit.resourceTree.addFolderFromExplorer",
		"onCommand:wispkit.resourceTree.compareBrowse",
		"onView:wispkit.resourceTree",
		"onView:wispkit.storage",
		"onCommand:wispkit.storage.refresh",
		"onCustomEditor:wispkit.text",
		"onStartupFinished"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "wispkit",
					"title": "Wispkit",
					"icon": "media/wispkit-activity.svg"
				}
			]
		},
		"views": {
			"wispkit": [
				{
					"id": "wispkit.resourceTree",
					"name": "%view.resourceTree.name%",
					"contextualTitle": "%view.resourceTree.contextualTitle%"
				},
				{
					"id": "wispkit.storage",
					"name": "%view.storage.name%",
					"contextualTitle": "%view.storage.contextualTitle%",
					"visibility": "collapsed"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "wispkit.resourceTree",
				"contents": "%viewsWelcome.resourceTree%"
			}
		],
		"customEditors": [
			{
				"viewType": "wispkit.markdown",
				"displayName": "Wispkit Markdown",
				"selector": [
					{
						"filenamePattern": "*.md"
					},
					{
						"filenamePattern": "*.markdown"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "wispkit.mermaid",
				"displayName": "%customEditor.mermaid.displayName%",
				"selector": [
					{
						"filenamePattern": "*.mmd"
					},
					{
						"filenamePattern": "*.mermaid"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "wispkit.image",
				"displayName": "Wispkit Image",
				"selector": [
					{
						"filenamePattern": "*.{png,jpg,jpe,jpeg,jfif,bmp,gif,ico,webp,avif,apng,svg,heic,heif,tif,tiff,jxl}"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "wispkit.video",
				"displayName": "Wispkit Video",
				"selector": [
					{
						"filenamePattern": "*.{mp4,m4v,mov,webm,ogv,mkv,avi,wmv,flv,mpg,mpeg,m2ts,3gp,3g2,rm,rmvb}"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "wispkit.html",
				"displayName": "Wispkit HTML",
				"selector": [
					{
						"filenamePattern": "*.html"
					},
					{
						"filenamePattern": "*.htm"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "wispkit.xaml",
				"displayName": "%customEditor.xaml.displayName%",
				"selector": [
					{
						"filenamePattern": "*.xaml"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "wispkit.text",
				"displayName": "%customEditor.text.displayName%",
				"selector": [
					{
						"filenamePattern": "*"
					}
				],
				"priority": "option"
			}
		],
		"commands": [
			{
				"command": "wispkit.openWith",
				"title": "%command.openWith.title%",
				"category": "Wispkit",
				"icon": "$(preview)"
			},
			{
				"command": "wispkit.toggleReadOnly",
				"title": "%command.toggleReadOnly.title%",
				"category": "Wispkit",
				"icon": "$(lock)"
			},
			{
				"command": "wispkit.subtree.open",
				"title": "%command.subtree.open.title%",
				"category": "Wispkit",
				"icon": "$(list-tree)"
			},
			{
				"command": "wispkit.wispkitView.open",
				"title": "%command.wispkitView.open.title%",
				"category": "Wispkit",
				"icon": "$(open-preview)"
			},
			{
				"command": "wispkit.graph3d.open",
				"title": "%command.graph3d.open.title%",
				"category": "Wispkit",
				"icon": "$(graph)"
			},
			{
				"command": "wispkit.resourceTree.addGroup",
				"title": "%command.resourceTree.addGroup.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(folder-library)"
			},
			{
				"command": "wispkit.resourceTree.addFolder",
				"title": "%command.resourceTree.addFolder.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(new-folder)"
			},
			{
				"command": "wispkit.resourceTree.addFolderFromExplorer",
				"title": "%command.resourceTree.addFolderFromExplorer.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(add)"
			},
			{
				"command": "wispkit.resourceTree.rename",
				"title": "%command.resourceTree.rename.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(edit)"
			},
			{
				"command": "wispkit.resourceTree.remove",
				"title": "%command.resourceTree.remove.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(trash)"
			},
			{
				"command": "wispkit.resourceTree.moveTo",
				"title": "%command.resourceTree.moveTo.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(move)"
			},
			{
				"command": "wispkit.resourceTree.moveUp",
				"title": "%command.resourceTree.moveUp.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(arrow-up)"
			},
			{
				"command": "wispkit.resourceTree.moveDown",
				"title": "%command.resourceTree.moveDown.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(arrow-down)"
			},
			{
				"command": "wispkit.resourceTree.openFolder",
				"title": "%command.resourceTree.openFolder.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(folder-opened)"
			},
			{
				"command": "wispkit.resourceTree.openTerminal",
				"title": "%command.resourceTree.openTerminal.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(terminal)"
			},
			{
				"command": "wispkit.resourceTree.copyPath",
				"title": "%command.resourceTree.copyPath.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(copy)"
			},
			{
				"command": "wispkit.resourceTree.openInVSCode",
				"title": "%command.resourceTree.openInVSCode.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(window)"
			},
			{
				"command": "wispkit.resourceTree.openInSystemExplorer",
				"title": "%command.resourceTree.openInSystemExplorer.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(folder-opened)"
			},
			{
				"command": "wispkit.resourceTree.systemTerminal.cmd",
				"title": "%command.resourceTree.systemTerminal.cmd.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(terminal)"
			},
			{
				"command": "wispkit.resourceTree.systemTerminal.powerShell",
				"title": "%command.resourceTree.systemTerminal.powerShell.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(terminal)"
			},
			{
				"command": "wispkit.resourceTree.systemTerminal.cmdAdmin",
				"title": "%command.resourceTree.systemTerminal.cmdAdmin.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(shield)"
			},
			{
				"command": "wispkit.resourceTree.systemTerminal.powerShellAdmin",
				"title": "%command.resourceTree.systemTerminal.powerShellAdmin.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(shield)"
			},
			{
				"command": "wispkit.resourceTree.systemTerminal.terminalApp",
				"title": "%command.resourceTree.systemTerminal.terminalApp.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(terminal)"
			},
			{
				"command": "wispkit.resourceTree.systemTerminal.linux",
				"title": "%command.resourceTree.systemTerminal.linux.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(terminal)"
			},
			{
				"command": "wispkit.resourceTree.refresh",
				"title": "%command.resourceTree.refresh.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(refresh)"
			},
			{
				"command": "wispkit.resourceTree.compareBrowse",
				"title": "%command.resourceTree.compareBrowse.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "wispkit.resourceTree.import",
				"title": "%command.resourceTree.import.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(cloud-download)"
			},
			{
				"command": "wispkit.resourceTree.export",
				"title": "%command.resourceTree.export.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "wispkit.resourceTree.openStorage",
				"title": "%command.resourceTree.openStorage.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(json)"
			},
			{
				"command": "wispkit.storage.refresh",
				"title": "%command.storage.refresh.title%",
				"category": "%command.category.resourceTree%",
				"icon": "$(refresh)"
			}
		],
		"submenus": [
			{
				"id": "wispkit.resourceTree.systemTerminalMenu",
				"label": "%submenu.systemTerminal.label%"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "wispkit.openWith",
					"when": "resourceLangId == markdown && activeCustomEditorId == ''",
					"group": "navigation@1"
				}
			],
			"explorer/context": [
				{
					"command": "wispkit.wispkitView.open",
					"when": "explorerResourceIsFolder",
					"group": "inline@1"
				},
				{
					"command": "wispkit.subtree.open",
					"when": "explorerResourceIsFolder",
					"group": "inline@2"
				},
				{
					"command": "wispkit.graph3d.open",
					"when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mmd || resourceExtname == .mermaid",
					"group": "navigation@3"
				},
				{
					"command": "wispkit.resourceTree.addFolderFromExplorer",
					"when": "explorerResourceIsFolder",
					"group": "navigation@4"
				}
			],
			"view/title": [
				{
					"command": "wispkit.resourceTree.addGroup",
					"when": "view == wispkit.resourceTree",
					"group": "navigation@1"
				},
				{
					"command": "wispkit.resourceTree.addFolder",
					"when": "view == wispkit.resourceTree",
					"group": "navigation@2"
				},
				{
					"command": "wispkit.resourceTree.refresh",
					"when": "view == wispkit.resourceTree",
					"group": "navigation@3"
				},
				{
					"command": "wispkit.resourceTree.compareBrowse",
					"when": "view == wispkit.resourceTree",
					"group": "navigation@4"
				},
				{
					"command": "wispkit.resourceTree.import",
					"when": "view == wispkit.resourceTree",
					"group": "9_io@1"
				},
				{
					"command": "wispkit.resourceTree.export",
					"when": "view == wispkit.resourceTree",
					"group": "9_io@2"
				},
				{
					"command": "wispkit.resourceTree.openStorage",
					"when": "view == wispkit.resourceTree",
					"group": "9_io@3"
				},
				{
					"command": "wispkit.storage.refresh",
					"when": "view == wispkit.storage",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "wispkit.resourceTree.openFolder",
					"when": "view == wispkit.resourceTree && viewItem == wispkitResourceFolder",
					"group": "inline@1"
				},
				{
					"command": "wispkit.resourceTree.openTerminal",
					"when": "view == wispkit.resourceTree && viewItem == wispkitResourceFolder",
					"group": "inline@2"
				},
				{
					"command": "wispkit.resourceTree.openFolder",
					"when": "view == wispkit.resourceTree && viewItem == wispkitResourceFolder",
					"group": "4_open@1"
				},
				{
					"command": "wispkit.resourceTree.copyPath",
					"when": "view == wispkit.resourceTree && viewItem == wispkitResourceFolder",
					"group": "4_open@2"
				},
				{
					"command": "wispkit.resourceTree.openTerminal",
					"when": "view == wispkit.resourceTree && viewItem == wispkitResourceFolder",
					"group": "4_open@3"
				},
				{
					"submenu": "wispkit.resourceTree.systemTerminalMenu",
					"when": "view == wispkit.resourceTree && viewItem == wispkitResourceFolder || view == wispkit.storage && viewItem == wispkitStorageMount",
					"group": "4_open@4"
				},
				{
					"command": "wispkit.resourceTree.openInVSCode",
					"when": "view == wispkit.resourceTree && viewItem == wispkitResourceFolder",
					"group": "4_open@5"
				},
				{
					"command": "wispkit.resourceTree.openInSystemExplorer",
					"when": "view == wispkit.resourceTree && viewItem == wispkitResourceFolder",
					"group": "4_open@6"
				},
				{
					"command": "wispkit.resourceTree.addGroup",
					"when": "view == wispkit.resourceTree && viewItem =~ /^wispkitResource(Group|Folder)$/",
					"group": "1_add@1"
				},
				{
					"command": "wispkit.resourceTree.addFolder",
					"when": "view == wispkit.resourceTree && viewItem =~ /^wispkitResource(Group|Folder)$/",
					"group": "1_add@2"
				},
				{
					"command": "wispkit.resourceTree.rename",
					"when": "view == wispkit.resourceTree && viewItem =~ /^wispkitResource(Group|Folder)$/",
					"group": "2_edit@1"
				},
				{
					"command": "wispkit.resourceTree.moveTo",
					"when": "view == wispkit.resourceTree && viewItem =~ /^wispkitResource(Group|Folder)$/",
					"group": "2_edit@2"
				},
				{
					"command": "wispkit.resourceTree.moveUp",
					"when": "view == wispkit.resourceTree && viewItem =~ /^wispkitResource(Group|Folder)$/",
					"group": "2_edit@3"
				},
				{
					"command": "wispkit.resourceTree.moveDown",
					"when": "view == wispkit.resourceTree && viewItem =~ /^wispkitResource(Group|Folder)$/",
					"group": "2_edit@4"
				},
				{
					"command": "wispkit.resourceTree.remove",
					"when": "view == wispkit.resourceTree && viewItem =~ /^wispkitResource(Group|Folder)$/",
					"group": "3_remove@1"
				},
				{
					"command": "wispkit.resourceTree.openFolder",
					"when": "view == wispkit.storage && viewItem == wispkitStorageMount",
					"group": "inline@1"
				},
				{
					"command": "wispkit.resourceTree.openTerminal",
					"when": "view == wispkit.storage && viewItem == wispkitStorageMount",
					"group": "inline@2"
				},
				{
					"command": "wispkit.resourceTree.openFolder",
					"when": "view == wispkit.storage && viewItem == wispkitStorageMount",
					"group": "4_open@1"
				},
				{
					"command": "wispkit.resourceTree.copyPath",
					"when": "view == wispkit.storage && viewItem == wispkitStorageMount",
					"group": "4_open@2"
				},
				{
					"command": "wispkit.resourceTree.openTerminal",
					"when": "view == wispkit.storage && viewItem == wispkitStorageMount",
					"group": "4_open@3"
				},
				{
					"command": "wispkit.resourceTree.openInVSCode",
					"when": "view == wispkit.storage && viewItem == wispkitStorageMount",
					"group": "4_open@5"
				},
				{
					"command": "wispkit.resourceTree.openInSystemExplorer",
					"when": "view == wispkit.storage && viewItem == wispkitStorageMount",
					"group": "4_open@6"
				}
			],
			"wispkit.resourceTree.systemTerminalMenu": [
				{
					"command": "wispkit.resourceTree.systemTerminal.cmd",
					"when": "isWindows",
					"group": "1_windows@1"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.powerShell",
					"when": "isWindows",
					"group": "1_windows@2"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.cmdAdmin",
					"when": "isWindows",
					"group": "2_windowsAdmin@1"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.powerShellAdmin",
					"when": "isWindows",
					"group": "2_windowsAdmin@2"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.terminalApp",
					"when": "isMac",
					"group": "3_macos@1"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.linux",
					"when": "isLinux",
					"group": "4_linux@1"
				}
			],
			"commandPalette": [
				{
					"command": "wispkit.subtree.open",
					"when": "false"
				},
				{
					"command": "wispkit.wispkitView.open",
					"when": "false"
				},
				{
					"command": "wispkit.resourceTree.addFolderFromExplorer",
					"when": "false"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.cmd",
					"when": "isWindows"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.powerShell",
					"when": "isWindows"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.cmdAdmin",
					"when": "isWindows"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.powerShellAdmin",
					"when": "isWindows"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.terminalApp",
					"when": "isMac"
				},
				{
					"command": "wispkit.resourceTree.systemTerminal.linux",
					"when": "isLinux"
				},
				{
					"command": "wispkit.graph3d.open",
					"when": "true"
				}
			]
		},
		"configuration": {
			"title": "Wispkit",
			"properties": {
				"wispkit.toc.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.toc.enabled.description%"
				},
				"wispkit.toc.depth": {
					"type": "number",
					"default": 6,
					"minimum": 1,
					"maximum": 6,
					"description": "%config.toc.depth.description%"
				},
				"wispkit.zoom.wheelStep": {
					"type": "number",
					"default": 1.1,
					"minimum": 1.01,
					"maximum": 3,
					"description": "%config.zoom.wheelStep.description%"
				},
				"wispkit.image.wheelZoom": {
					"type": "boolean",
					"default": true,
					"description": "%config.image.wheelZoom.description%"
				},
				"wispkit.image.dragButton": {
					"type": "string",
					"enum": [
						"right",
						"middle",
						"left"
					],
					"default": "right",
					"description": "%config.image.dragButton.description%"
				},
				"wispkit.xaml.codeVisible": {
					"type": "boolean",
					"default": true,
					"description": "%config.xaml.codeVisible.description%"
				},
				"wispkit.xaml.codeWidth": {
					"type": "number",
					"default": 460,
					"minimum": 160,
					"description": "%config.xaml.codeWidth.description%"
				},
				"wispkit.readonly.default": {
					"type": "boolean",
					"default": false,
					"description": "%config.readonly.default.description%"
				},
				"wispkit.readonly.previewBytes": {
					"type": "number",
					"default": 65536,
					"minimum": 1024,
					"description": "%config.readonly.previewBytes.description%"
				},
				"wispkit.readonly.previewLines": {
					"type": "number",
					"default": 800,
					"minimum": 50,
					"description": "%config.readonly.previewLines.description%"
				},
				"wispkit.readonly.extensions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"*.txt",
						"*.text",
						"*.log",
						"*.csv",
						"*.ini",
						"*.cfg",
						"*.conf",
						"*.properties",
						"*.json",
