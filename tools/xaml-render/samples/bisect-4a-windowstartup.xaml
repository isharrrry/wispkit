<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:shared="clr-namespace:NewsBoard.Shared.Components;assembly=NewsBoard.Shared"
        Title="二分样本 4a：加 WindowStartupLocation" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FF000000">
  <blazor:BlazorWebView x:Name="Blazor" HostPage="wwwroot\index.html">
    <blazor:BlazorWebView.RootComponents>
      <blazor:RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
    </blazor:BlazorWebView.RootComponents>
  </blazor:BlazorWebView>
</Window>
