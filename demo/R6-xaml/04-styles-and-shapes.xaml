<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="560"
    Height="400"
    Background="White">
    <Grid.Resources>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FF1F5FBF" />
            <GradientStop Offset="1" Color="#FF3FA0E0" />
        </LinearGradientBrush>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF555555" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border
        Grid.Row="0"
        Padding="14,10"
        Background="{StaticResource HeaderBrush}">
        <TextBlock
            FontSize="16"
            FontWeight="Bold"
            Foreground="White"
            Text="样式与图形示例 · 同文件资源 + 形状" />
    </Border>

    <Grid Grid.Row="1" Margin="14,12,14,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource CaptionText}" Text="形状" />
            <Canvas Width="240" Height="150" HorizontalAlignment="Left">
                <Rectangle
                    Canvas.Left="6"
                    Canvas.Top="6"
                    Width="90"
                    Height="60"
                    Fill="#FFD9E7FB"
                    Stroke="#FF3B78C8"
                    StrokeThickness="2"
                    RadiusX="6"
                    RadiusY="6" />
                <Ellipse
                    Canvas.Left="112"
                    Canvas.Top="6"
                    Width="90"
                    Height="60"
                    Fill="#FFDDF3E0"
                    Stroke="#FF3F9A56"
                    StrokeThickness="2" />
                <Path
                    Canvas.Left="14"
                    Canvas.Top="80"
                    Data="M 0,0 L 40,0 L 20,40 Z"
                    Fill="#FFFBE3D0"
                    Stroke="#FFC97A2B"
                    StrokeThickness="2" />
                <Line
                    X1="80"
                    X2="196"
                    Y1="100"
                    Y2="100"
                    Stroke="#FF999999"
                    StrokeThickness="2"
                    StrokeDashArray="4 3" />
                <TextBlock
                    Canvas.Left="80"
                    Canvas.Top="112"
                    Foreground="#FF777777"
                    Text="虚线 / 三角 / 圆角矩形" />
            </Canvas>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource CaptionText}" Text="样式应用" />
            <Button Content="隐式样式按钮" HorizontalAlignment="Left" />
            <Button Content="另一个按钮" HorizontalAlignment="Left" />
            <TextBlock
                Margin="0,10,0,0"
                FontSize="15"
                FontWeight="Bold"
                Text="加粗标题（检查字形）" />
            <TextBlock
                Margin="0,4,0,0"
                FontStyle="Italic"
                Text="斜体正文，用来对比字形与行距。" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="#FF888888"
                Text="灰色说明文字" />
            <Expander
                Margin="0,12,0,0"
                Header="展开查看详情"
                IsExpanded="True">
                <TextBlock TextWrapping="Wrap" Text="折叠容器内的内容，默认展开。" />
            </Expander>
        </StackPanel>
    </Grid>

    <TextBlock
        Grid.Row="2"
        Margin="14,12,14,14"
        Foreground="#FF777777"
        Text="标题栏用的是同文件内定义的 LinearGradientBrush（StaticResource）。" />
</Grid>
