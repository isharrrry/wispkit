<TabControl
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="640"
	Height="420"
	Background="#FFFFFFFF"
	FontFamily="Microsoft YaHei UI">
	<TabItem Header="设备清单">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Background="#FFEDF2F9" Padding="12,8">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="1*" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="名称" FontWeight="Bold" Foreground="#FF33475B" />
					<TextBlock Grid.Column="1" Text="类型" FontWeight="Bold" Foreground="#FF33475B" />
					<TextBlock Grid.Column="2" Text="高度" FontWeight="Bold" Foreground="#FF33475B" />
					<TextBlock Grid.Column="3" Text="状态" FontWeight="Bold" Foreground="#FF33475B" />
				</Grid>
			</Border>

			<ListBox Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Stretch">
				<ListBoxItem Padding="6,4">
					<Grid Width="600">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="管理计算机" />
						<TextBlock Grid.Column="1" Text="服务器" />
						<TextBlock Grid.Column="2" Text="2U" />
						<TextBlock Grid.Column="3" Text="在线" Foreground="#FF1B8A3A" />
					</Grid>
				</ListBoxItem>
				<ListBoxItem Padding="6,4">
					<Grid Width="600">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="飞控计算机" />
						<TextBlock Grid.Column="1" Text="工控机" />
						<TextBlock Grid.Column="2" Text="2U" />
						<TextBlock Grid.Column="3" Text="在线" Foreground="#FF1B8A3A" />
					</Grid>
				</ListBoxItem>
				<ListBoxItem Padding="6,4">
					<Grid Width="600">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="故障注入计算机" />
						<TextBlock Grid.Column="1" Text="插箱" />
						<TextBlock Grid.Column="2" Text="3U" />
						<TextBlock Grid.Column="3" Text="待机" Foreground="#FFB26A00" />
					</Grid>
				</ListBoxItem>
				<ListBoxItem Padding="6,4">
					<Grid Width="600">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="存储阵列" />
						<TextBlock Grid.Column="1" Text="存储" />
						<TextBlock Grid.Column="2" Text="4U" />
						<TextBlock Grid.Column="3" Text="在线" Foreground="#FF1B8A3A" />
					</Grid>
				</ListBoxItem>
				<ListBoxItem Padding="6,4">
					<Grid Width="600">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="路由器" />
						<TextBlock Grid.Column="1" Text="网络" />
						<TextBlock Grid.Column="2" Text="1U" />
						<TextBlock Grid.Column="3" Text="离线" Foreground="#FFB3261E" />
					</Grid>
				</ListBoxItem>
			</ListBox>
		</Grid>
	</TabItem>

	<TabItem Header="日志">
		<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
			<StackPanel>
				<!-- StackPanel 不是 Control，没有 FontFamily/FontSize 属性 -->
				<StackPanel.Resources>
					<Style TargetType="TextBlock">
						<Setter Property="FontFamily" Value="Consolas" />
						<Setter Property="FontSize" Value="12" />
					</Style>
				</StackPanel.Resources>
				<TextBlock Text="[INFO] 12:00:01 设备初始化完成" Foreground="#FF1B8A3A" />
				<TextBlock Text="[INFO] 12:00:03 冗余通道已启用" Foreground="#FF1B8A3A" />
				<TextBlock Text="[WARN] 12:00:07 采样率 65%，低于推荐值" Foreground="#FFB26A00" />
				<TextBlock Text="[INFO] 12:00:11 遥测上报成功" Foreground="#FF1B8A3A" />
				<TextBlock Text="[ERROR] 12:00:19 路由器心跳超时" Foreground="#FFB3261E" />
				<TextBlock Text="[INFO] 12:00:24 重连成功" Foreground="#FF1B8A3A" />
				<TextBlock Text="[INFO] 12:00:31 列表已刷新，共 5 条记录" Foreground="#FF1B8A3A" />
			</StackPanel>
		</ScrollViewer>
	</TabItem>
</TabControl>
