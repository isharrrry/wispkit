<Grid
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="560"
	Height="400"
	Background="#FFFFFFFF">
	<Grid.Resources>
		<!-- Grid 不是 Control，没有 FontFamily 属性；要给中文换字体只能走隐式样式 -->
		<Style TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Microsoft YaHei UI" />
		</Style>
		<Style TargetType="Button">
			<Setter Property="FontFamily" Value="Microsoft YaHei UI" />
		</Style>
		<Style TargetType="CheckBox">
			<Setter Property="FontFamily" Value="Microsoft YaHei UI" />
		</Style>
		<Style TargetType="RadioButton">
			<Setter Property="FontFamily" Value="Microsoft YaHei UI" />
		</Style>
		<Style TargetType="ComboBox">
			<Setter Property="FontFamily" Value="Microsoft YaHei UI" />
		</Style>
	</Grid.Resources>
	<Grid.RowDefinitions>
		<RowDefinition Height="Auto" />
		<RowDefinition Height="*" />
		<RowDefinition Height="Auto" />
	</Grid.RowDefinitions>

	<Border Grid.Row="0" Background="#FF1F6FEB" Padding="18,14">
		<TextBlock Text="设备登记表" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" />
	</Border>

	<Grid Grid.Row="1" Margin="20">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="96" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Grid.Column="0" Text="设备名称" VerticalAlignment="Center" Margin="0,0,0,12" Foreground="#FF444444" />
		<TextBox Grid.Row="0" Grid.Column="1" Text="飞控计算机 A" Padding="6,4" Margin="0,0,0,12" />

		<TextBlock Grid.Row="1" Grid.Column="0" Text="所属机柜" VerticalAlignment="Center" Margin="0,0,0,12" Foreground="#FF444444" />
		<ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="1" Padding="6,4" Margin="0,0,0,12">
			<ComboBoxItem Content="机柜 U1" />
			<ComboBoxItem Content="机柜 U2" />
			<ComboBoxItem Content="机柜 U3" />
		</ComboBox>

		<TextBlock Grid.Row="2" Grid.Column="0" Text="运行模式" VerticalAlignment="Center" Margin="0,0,0,12" Foreground="#FF444444" />
		<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
			<RadioButton Content="正常" IsChecked="True" Margin="0,0,16,0" />
			<RadioButton Content="降级" Margin="0,0,16,0" />
			<RadioButton Content="维护" />
		</StackPanel>

		<TextBlock Grid.Row="3" Grid.Column="0" Text="采样率" VerticalAlignment="Center" Margin="0,0,0,12" Foreground="#FF444444" />
		<Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Slider Grid.Column="0" Minimum="0" Maximum="100" Value="65" VerticalAlignment="Center" />
			<TextBlock Grid.Column="1" Text="65 %" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF666666" />
		</Grid>

		<TextBlock Grid.Row="4" Grid.Column="0" Text="选项" VerticalAlignment="Center" Margin="0,0,0,12" Foreground="#FF444444" />
		<StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
			<CheckBox Content="启用冗余通道" IsChecked="True" Margin="0,0,0,4" />
			<CheckBox Content="上报遥测数据" Margin="0,0,0,4" />
			<CheckBox Content="只读模式（禁用）" IsEnabled="False" />
		</StackPanel>

		<TextBlock Grid.Row="5" Grid.Column="0" Text="备注" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="#FF444444" />
		<TextBox Grid.Row="5" Grid.Column="1" Text="这是一段较长的备注文本，用来观察换行与高度表现。" TextWrapping="Wrap" AcceptsReturn="True" Height="56" Padding="6,4" VerticalScrollBarVisibility="Auto" />
	</Grid>

	<Border Grid.Row="2" Background="#FFF3F4F6" Padding="18,12">
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="取消" Padding="18,6" Margin="0,0,10,0" />
			<Button Content="保存" Padding="18,6" Background="#FF1F6FEB" Foreground="#FFFFFFFF" BorderBrush="#FF1F6FEB" />
		</StackPanel>
	</Border>
</Grid>
