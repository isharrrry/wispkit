<Grid
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="700"
	Height="460"
	Background="#FF0E1726">
	<Grid.Resources>
		<!-- Grid 不是 Control，没有 FontFamily 属性；中文换字体走隐式样式 -->
		<Style TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Microsoft YaHei UI" />
		</Style>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="#FF16213A" />
			<Setter Property="BorderBrush" Value="#FF24304D" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="14" />
			<Setter Property="Margin" Value="10" />
		</Style>
		<Style x:Key="CaptionStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#FF8FA3C8" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style x:Key="MetricStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#FFE8F0FF" />
			<Setter Property="FontSize" Value="30" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Margin" Value="0,6,0,0" />
		</Style>
		<Style TargetType="ProgressBar">
			<Setter Property="Height" Value="10" />
			<Setter Property="Margin" Value="0,10,0,0" />
			<Setter Property="Foreground" Value="#FF3DA9FC" />
			<Setter Property="Background" Value="#FF24304D" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style x:Key="StatusLed" TargetType="Ellipse">
			<Setter Property="Width" Value="9" />
			<Setter Property="Height" Value="9" />
			<Setter Property="Margin" Value="0,0,6,0" />
		</Style>
	</Grid.Resources>

	<Grid.RowDefinitions>
		<RowDefinition Height="Auto" />
		<RowDefinition Height="*" />
		<RowDefinition Height="Auto" />
	</Grid.RowDefinitions>

	<Border Grid.Row="0" Padding="16,14">
		<Border.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
				<GradientStop Color="#FF1B2A4A" Offset="0" />
				<GradientStop Color="#FF0E1726" Offset="1" />
			</LinearGradientBrush>
		</Border.Background>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0">
				<TextBlock Text="机柜运行看板" FontSize="19" FontWeight="Bold" Foreground="#FFF2F7FF" />
				<TextBlock Text="示例数据 · 静态快照" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
				<Ellipse Style="{StaticResource StatusLed}" Fill="#FF35D07F" />
				<TextBlock Text="在线" Foreground="#FF9FE8C0" VerticalAlignment="Center" FontSize="12" />
			</StackPanel>
		</Grid>
	</Border>

	<Grid Grid.Row="1">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0" Style="{StaticResource CardStyle}">
			<StackPanel>
				<TextBlock Text="CPU 占用" Style="{StaticResource CaptionStyle}" />
				<TextBlock Text="42 %" Style="{StaticResource MetricStyle}" />
				<ProgressBar Value="42" Maximum="100" />
			</StackPanel>
		</Border>

		<Border Grid.Column="1" Style="{StaticResource CardStyle}">
			<StackPanel>
				<TextBlock Text="内存占用" Style="{StaticResource CaptionStyle}" />
				<TextBlock Text="68 %" Style="{StaticResource MetricStyle}" />
				<ProgressBar Value="68" Maximum="100" />
			</StackPanel>
		</Border>

		<Border Grid.Column="2" Style="{StaticResource CardStyle}">
			<StackPanel>
				<TextBlock Text="磁盘占用" Style="{StaticResource CaptionStyle}" />
				<TextBlock Text="81 %" Style="{StaticResource MetricStyle}" />
				<ProgressBar Value="81" Maximum="100" />
			</StackPanel>
		</Border>
	</Grid>

	<StackPanel Grid.Row="2">
		<GroupBox Header="采样设置" Foreground="#FF8FA3C8" Margin="10,0,10,6">
			<StackPanel Margin="4">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="采样率" Foreground="#FFC7D4EA" VerticalAlignment="Center" Margin="0,0,10,0" />
					<Slider Grid.Column="1" Minimum="0" Maximum="100" Value="72" VerticalAlignment="Center" />
					<TextBlock Grid.Column="2" Text="72 %" Foreground="#FFC7D4EA" VerticalAlignment="Center" Margin="10,0,0,0" />
				</Grid>
				<Expander Header="高级参数" Foreground="#FF8FA3C8" Margin="0,10,0,0" IsExpanded="True">
					<StackPanel Margin="0,8,0,0">
						<CheckBox Content="启用抖动抑制" Foreground="#FFC7D4EA" IsChecked="True" Margin="0,0,0,4" />
						<CheckBox Content="记录原始波形" Foreground="#FFC7D4EA" Margin="0,0,0,4" />
						<CheckBox Content="自动上传（未启用）" Foreground="#FF7E8BA6" IsEnabled="False" />
					</StackPanel>
				</Expander>
			</StackPanel>
		</GroupBox>

		<StatusBar Background="#FF16213A">
			<StatusBarItem>
				<TextBlock Text="就绪 · 共 5 台设备" Foreground="#FF8FA3C8" FontSize="12" />
			</StatusBarItem>
			<Separator />
			<StatusBarItem>
				<TextBlock Text="最后刷新 12:00:31" Foreground="#FF8FA3C8" FontSize="12" />
			</StatusBarItem>
		</StatusBar>
	</StackPanel>
</Grid>
